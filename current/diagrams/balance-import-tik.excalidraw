    {
      "type": "text",
      "id": "tol_a",
      "x": 80,
      "y": 1762,
      "width": 880,
      "height": 22,
      "text": "\u2713  Off by a fractional share \u2192 acceptable. Close out and move on.",
      "originalText": "\u2713  Off by a fractional share \u2192 acceptable. Close out and move on.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
