    },
    {
      "type": "text",
      "id": "tol_b",
      "x": 80,
      "y": 1782,
      "width": 1700,
      "height": 22,
      "text": "\u2717  Off by more than one full share \u2192 escalate. Run it up to the prior record keeper, loop in chain of command. Don't paper over it.",
      "originalText": "\u2717  Off by more than one full share \u2192 escalate. Run it up to the prior record keeper, loop in chain of command. Don't paper over it.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#dc2626",
